# Copy to .env.production; DNS A records for all three domains must target PUBLIC_IPV4.
RENE_DOMAIN=rene.example.com
VOICE_DOMAIN=voice.example.com
TURN_DOMAIN=turn.example.com
PUBLIC_IPV4=203.0.113.10
ACME_EMAIL=admin@example.com
# Generate each secret separately: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
LIVEKIT_API_KEY=rene_production
LIVEKIT_API_SECRET=CHANGE_ME
# These networks are private Docker networks. Change if they overlap your host/VPN.
RENE_NETWORK_SUBNET=172.30.92.0/24
