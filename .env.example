# Copy to .env. Local-only credentials; replace them before any public deployment.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Remove DATABASE_URL to use the explicit volatile development adapter.
# Host port for Docker PostgreSQL; keep DATABASE_URL aligned with this value.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rene:rene_local_only@localhost:5433/rene?schema=public
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=rene_dev
LIVEKIT_API_SECRET=rene_development_secret_not_for_production
