# Copy to .env.caddy. Replace domains, addresses and secrets before generation.
RENE_DOMAIN=rene.example.com
VOICE_DOMAIN=voice.example.com
# Address reachable directly by players: server LAN IPv4 for LAN play, public IPv4 for Internet.
# For Internet, forward 7881/TCP and 7882/UDP to the Docker host with the same port numbers.
LIVEKIT_NODE_IP=192.168.1.50
# Only for Caddy installed on the host: publish upstream HTTP on loopback.
# These HTTP publications are removed by the Docker Caddy network variant.
RENE_BIND_ADDRESS=127.0.0.1
RENE_HTTP_PORT=8080
LIVEKIT_HTTP_PORT=7880
# Use a private subnet that does not overlap the host LAN, VPN or other Docker networks.
RENE_NETWORK_SUBNET=172.30.93.0/24
# Replace with Caddy's address/subnet on CADDY_NETWORK for container Caddy.
# The example below is the Linux bridge gateway for Caddy installed on the host.
RENE_TRUST_PROXY=172.30.93.1/32
# Only used by compose.existing-caddy.network.yml; Caddy must already join this network.
CADDY_NETWORK=web
# Generate each secret separately: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
LIVEKIT_API_KEY=rene_production
LIVEKIT_API_SECRET=CHANGE_ME
